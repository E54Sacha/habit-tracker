# Copy to api/.env for local development (never commit .env).
DATABASE_URL=postgresql+psycopg://habits:habits@localhost:5432/habits
# Any long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
# true in production (HTTPS only); false locally (http://localhost)
COOKIE_SECURE=false
ENVIRONMENT=development
